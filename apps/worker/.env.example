ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_TABLE=analysis_jobs

POLL_INTERVAL_SECONDS=5

# --- LLM ---
# Valid providers: anthropic, openai, groq
LLM_PROVIDER=groq
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0

# --- External APIs ---
OPENALEX_EMAIL=
API_TIMEOUT_SECONDS=30

# --- Pipeline ---
PIPELINE_NAME=biblio-checker
PIPELINE_VERSION=0.1.0
MAX_TEXT_CHARS=500000
MAX_REFERENCES=150

# --- AI-Enhanced Classification ---
# Master toggle for LLM adjudication of uncertain references.
# Adds 1 batched LLM call per job (only for references with manualReviewRequired=true).
# Disable to eliminate adjudication LLM costs while keeping deterministic enrichments.
AI_ADJUDICATION_ENABLED=true

# Max number of uncertain references sent to the LLM adjudicator per job (1–150).
# References are sorted by lowest confidence score — most uncertain get priority.
AI_ADJUDICATION_MAX_REFERENCES=20

# Toggle for cross-reference pattern detection (deterministic checks + optional LLM).
# When false, the analyze_cross_patterns node passes through with no analysis.
CROSS_PATTERN_ANALYSIS_ENABLED=true

# Toggle for the LLM call within cross-pattern analysis.
# When false, deterministic pattern checks still run but no LLM analysis is made.
# Adds 1 LLM call per job only when patterns are detected.
# Maximum additional LLM calls per job: 2 (adjudication + cross-pattern analysis).
# To minimize cost: set AI_ADJUDICATION_ENABLED=false and CROSS_PATTERN_LLM_ENABLED=false.
CROSS_PATTERN_LLM_ENABLED=true
